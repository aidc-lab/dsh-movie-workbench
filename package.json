{
  "name": "dsh-movie-workbench",
  "version": "1.10.0",
  "description": "Movies workbench — search film and TV titles across TMDB, IMDb and DouBan from a left-sidebar panel.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidc-lab/dsh-movie-workbench.git"
  },
  "homepage": "https://github.com/aidc-lab/dsh-movie-workbench#readme",
  "bugs": {
    "url": "https://github.com/aidc-lab/dsh-movie-workbench/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "movies",
    "tv",
    "tmdb",
    "imdb",
    "douban"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
